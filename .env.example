# =============================================
# Empresa AI — variáveis de ambiente
# Copie esse arquivo pra .env e preencha os valores.
# NUNCA comitar o .env (já está no .gitignore).
# =============================================

# Telegram bot do aluno (criar via @BotFather)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Supabase do aluno (criar projeto próprio em supabase.com)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Anthropic API (claude.ai/console)
ANTHROPIC_API_KEY=

# GitHub PAT (settings/tokens — escopo repo + workflow)
GITHUB_TOKEN=

# Outros serviços (preencher conforme nicho do aluno)
POST_FOR_ME_API_KEY=
GHL_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=

# Google APIs (se usar gcal/gdrive/gmail)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
